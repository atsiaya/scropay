{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/orders/[id]/confirm",
      "regex": "^/api/orders/([^/]+?)/confirm(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/orders/(?<nxtPid>[^/]+?)/confirm(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/buy/stk-push",
      "regex": "^/api/buy/stk\\-push(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/buy/stk\\-push(?:/)?$"
    },
    {
      "page": "/api/kyc",
      "regex": "^/api/kyc(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/kyc(?:/)?$"
    },
    {
      "page": "/api/orders",
      "regex": "^/api/orders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/orders(?:/)?$"
    },
    {
      "page": "/api/rate",
      "regex": "^/api/rate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/rate(?:/)?$"
    },
    {
      "page": "/api/webhooks/didit",
      "regex": "^/api/webhooks/didit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/webhooks/didit(?:/)?$"
    },
    {
      "page": "/api/webhooks/kopokopo",
      "regex": "^/api/webhooks/kopokopo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/webhooks/kopokopo(?:/)?$"
    },
    {
      "page": "/buy/pay",
      "regex": "^/buy/pay(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/buy/pay(?:/)?$"
    },
    {
      "page": "/connect",
      "regex": "^/connect(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/connect(?:/)?$"
    },
    {
      "page": "/kyc",
      "regex": "^/kyc(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kyc(?:/)?$"
    },
    {
      "page": "/kyc/callback",
      "regex": "^/kyc/callback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kyc/callback(?:/)?$"
    },
    {
      "page": "/sell/deposit",
      "regex": "^/sell/deposit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sell/deposit(?:/)?$"
    },
    {
      "page": "/sell/payout",
      "regex": "^/sell/payout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sell/payout(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}