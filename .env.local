# Optional. A free CoinGecko "Demo" API key (https://www.coingecko.com/en/api/pricing)
# raises the price-feed rate limit from ~5-15 req/min (shared, keyless) to a
# stable 30 req/min. Not required to run the app — without it, the keyless
# public endpoint is used and still works fine at our 20s poll interval.
COINGECKO_API_KEY=

# Required for the wallet-connect step to work at all. Get a free Project ID
# at https://cloud.reown.com (a couple of minutes to set up — this is the
# WalletConnect successor). Without it, the "Connect Wallet" button on
# /connect stays disabled with an explanatory message rather than crashing.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=accbd93a9c77219c9ae3be346e40e8d5

# Used as the AppKit modal's metadata URL. Set to your real deployed origin
# in production; localhost is fine for development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where users send USDT for a Sell order, per network. Without these, the
# app falls back to an obviously-fake placeholder address (0x1111...1111)
# so the deposit screen still renders in a fresh checkout — replace before
# any real deposit is expected. See README "Attributing incoming deposits"
# for why a single static address per network is a simplification, not a
# production-ready design.
TREASURY_ADDRESS_CELO=
TREASURY_ADDRESS_POLYGON=
TREASURY_ADDRESS_BASE=
TREASURY_ADDRESS_TRON=
